#!/command/with-contenv bashio
# ==============================================================================
# config by Caesar
# Renew certificate
# ==============================================================================

DOMAIN=$(bashio::config 'domain')

if [[ $(/usr/bin/openssl x509 -checkend 10800 -noout -in "/ssl/${DOMAIN}/cert.pem" &> /dev/null; echo $?) -eq 1 ]]; then
  bashio::log.info "Renewing certificate file for ${DOMAIN}"

  ACMEDIR=$(bashio::config 'acmedir' | sed '/^null$/d')
  HOOK=$(bashio::config 'hook')

  /usr/bin/uacme "${ACMEDIR:+-a $ACMEDIR}" -c /ssl -h "${HOOK}" issue "${DOMAIN}"
fi
